# Copy to .env for local use; inject secrets on Railway.
# Generate a key locally and set it here; empty keys cannot authenticate.
AGENT_API_KEY=
PORT=8000
ENVIRONMENT=development
WEB_CONCURRENCY=2
LOG_LEVEL=INFO
LLM_PROVIDER=mock

# Railway CP6: set LLM_PROVIDER=groq and enter a NEW Groq key on Railway.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=512
GROQ_CONTEXT_WINDOW_TOKENS=131072
GROQ_TIMEOUT_SECONDS=5
GROQ_PRICE_INPUT_PER_1K_USD=0.000075
GROQ_PRICE_OUTPUT_PER_1K_USD=0.0003

# Docker Compose overrides REDIS_URL with its internal service address.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=day14:agent
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1

RATE_LIMIT_PER_MINUTE=10
# Zero budget blocks all model calls. Periods use UTC.
DAILY_BUDGET_USD=1
MONTHLY_BUDGET_USD=10

# Mock accounting constants, not live Groq prices.
PRICE_INPUT_PER_1K_USD=0.00015
PRICE_OUTPUT_PER_1K_USD=0.0006
